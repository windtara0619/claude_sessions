<title>TPU Profile: mega_kernel vs baseline</title>
<style>
  :root {
    --bg: #f5f7fa; --surface: #ffffff; --surface2: #f0f2f5;
    --border: #dde1e7; --border-faint: #eaecf0;
    --text: #1a1d23; --text-2: #5c6370; --text-3: #8b919e;
    --mega: #e8570a; --base: #1a7f37;
    --c-rpa:   #3b82f6;
    --c-qkv:   #ef4444;
    --c-ffn:   #8b5cf6;
    --c-copy:  #f59e0b;
    --c-misc:  #94a3b8;
    --c-rpad:  #22c55e;
    --mono: 'SF Mono','Fira Code','Cascadia Code','Consolas',monospace;
    --sans: 'Inter','SF Pro Text',system-ui,-apple-system,sans-serif;
    --r: 6px;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0d1117; --surface: #161b22; --surface2: #1c2128;
      --border: #30363d; --border-faint: #21262d;
      --text: #e6edf3; --text-2: #8b949e; --text-3: #58636e;
      --mega: #f0883e; --base: #3fb950;
      --c-rpa: #4493f8; --c-qkv: #f85149; --c-ffn: #a371f7;
      --c-copy: #e3b341; --c-misc: #58636e; --c-rpad: #3fb950;
    }
  }
  :root[data-theme="light"] {
    --bg:#f5f7fa;--surface:#fff;--surface2:#f0f2f5;--border:#dde1e7;--border-faint:#eaecf0;
    --text:#1a1d23;--text-2:#5c6370;--text-3:#8b919e;--mega:#e8570a;--base:#1a7f37;
    --c-rpa:#3b82f6;--c-qkv:#ef4444;--c-ffn:#8b5cf6;--c-copy:#f59e0b;--c-misc:#94a3b8;--c-rpad:#22c55e;
  }
  :root[data-theme="dark"] {
    --bg:#0d1117;--surface:#161b22;--surface2:#1c2128;--border:#30363d;--border-faint:#21262d;
    --text:#e6edf3;--text-2:#8b949e;--text-3:#58636e;--mega:#f0883e;--base:#3fb950;
    --c-rpa:#4493f8;--c-qkv:#f85149;--c-ffn:#a371f7;--c-copy:#e3b341;--c-misc:#58636e;--c-rpad:#3fb950;
  }
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
  body{background:var(--bg);color:var(--text);font-family:var(--sans);font-size:13px;
    line-height:1.6;padding:26px 22px 60px;max-width:960px;margin:0 auto}

  .page-header{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;
    padding-bottom:16px;border-bottom:1px solid var(--border);margin-bottom:22px}
  .page-header h1{font-size:17px;font-weight:600;letter-spacing:-.3px}
  .page-header .meta{font-size:11.5px;color:var(--text-2);margin-top:3px;font-family:var(--mono)}
  .badge{display:inline-block;font-size:11px;font-family:var(--mono);font-weight:500;
    padding:3px 8px;border-radius:20px;white-space:nowrap}
  .badge-mega{background:color-mix(in srgb,var(--mega) 14%,transparent);color:var(--mega)}
  .badge-base{background:color-mix(in srgb,var(--base) 14%,transparent);color:var(--base)}
  .slabel{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;
    color:var(--text-3);margin-bottom:8px}

  /* ── KPIs ── */
  .kpi-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:22px}
  @media(max-width:600px){.kpi-grid{grid-template-columns:1fr 1fr}}
  .kpi{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:11px 13px}
  .kpi-lbl{font-size:11px;color:var(--text-2);margin-bottom:4px}
  .kpi-val{font-family:var(--mono);font-size:19px;font-weight:700;font-variant-numeric:tabular-nums;line-height:1.1}
  .kpi-sub{font-size:10.5px;color:var(--text-2);margin-top:2px;font-family:var(--mono)}
  .bad{color:var(--mega)} .good{color:var(--base)}

  /* ── Main table ── */
  .table-wrap{overflow-x:auto;border-radius:var(--r);border:1px solid var(--border);margin-bottom:20px}
  table{width:100%;border-collapse:collapse;background:var(--surface);font-size:12px}
  thead tr:first-child th{
    text-align:left;padding:9px 12px;
    font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;
    color:var(--text-3);background:var(--surface2);border-bottom:1px solid var(--border);
    white-space:nowrap
  }
  thead tr:first-child th.r{text-align:right}
  thead tr.subhead th{
    padding:5px 12px;font-size:10px;font-weight:600;color:var(--text-3);
    border-bottom:2px solid var(--border);white-space:nowrap;text-align:right
  }
  thead tr.subhead th:first-child{text-align:left}
  thead tr.subhead th.group-mega{
    background:color-mix(in srgb,var(--mega) 8%,transparent);
    border-bottom-color:var(--mega)
  }
  thead tr.subhead th.group-base{
    background:color-mix(in srgb,var(--base) 8%,transparent);
    border-bottom-color:var(--base)
  }
  thead tr.subhead th.group-ratio{
    background:color-mix(in srgb,var(--text-3) 8%,transparent)
  }
  tbody td{
    padding:8px 12px;border-bottom:1px solid var(--border-faint);
    font-family:var(--mono);font-variant-numeric:tabular-nums;white-space:nowrap;vertical-align:middle
  }
  tbody td.name{font-family:var(--sans);font-size:11.5px}
  tbody td.r{text-align:right}
  tbody tr:last-child td{border-bottom:none}
  tbody tr:hover td{background:color-mix(in srgb,var(--text) 3%,transparent)}
  tr.sep td{border-top:2px solid var(--border);background:var(--surface2)}
  tr.sep td.name{font-weight:700;font-size:12px;color:var(--text)}
  .chip{display:inline-block;font-family:var(--mono);font-size:10.5px;font-weight:600;
    padding:1px 6px;border-radius:20px}
  .chip-bad{background:color-mix(in srgb,var(--mega) 15%,transparent);color:var(--mega)}
  .chip-good{background:color-mix(in srgb,var(--base) 15%,transparent);color:var(--base)}
  .chip-neu{background:var(--surface2);color:var(--text-2)}
  .swatch{display:inline-block;width:7px;height:7px;border-radius:2px;
    margin-right:5px;vertical-align:middle;position:relative;top:-1px}
  .dim{color:var(--text-3)}
  .fused{font-style:italic;color:var(--text-3);font-size:10.5px}

  /* ── Bar section ── */
  .bar-section{background:var(--surface);border:1px solid var(--border);
    border-radius:var(--r);padding:15px 17px 13px;margin-bottom:20px}
  .bar-row{display:flex;align-items:center;gap:9px;margin-bottom:7px}
  .bar-run-label{font-family:var(--mono);font-size:10px;color:var(--text-2);
    width:100px;flex-shrink:0;text-align:right;white-space:nowrap}
  .run-dot{display:inline-block;width:6px;height:6px;border-radius:50%;
    margin-right:4px;vertical-align:middle;position:relative;top:-1px}
  .bar-track{flex:1;height:22px;background:var(--surface2);border-radius:3px;overflow:hidden;display:flex}
  .bar-seg{height:100%;flex-shrink:0;cursor:default}
  .bar-seg:hover{filter:brightness(1.12)}
  .bar-ms{font-family:var(--mono);font-size:11.5px;font-weight:600;
    font-variant-numeric:tabular-nums;width:62px;flex-shrink:0}
  .bar-legend{display:flex;flex-wrap:wrap;gap:4px 12px;margin-top:10px;
    padding-top:10px;border-top:1px solid var(--border-faint)}
  .leg-item{display:flex;align-items:center;gap:4px;font-size:10.5px;color:var(--text-2)}
  .leg-dot{width:8px;height:8px;border-radius:2px;flex-shrink:0}

  /* ── Note box ── */
  .note{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);
    padding:14px 16px;margin-bottom:20px}
  .note h3{font-size:12.5px;font-weight:600;margin-bottom:9px}
  .note-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  @media(max-width:580px){.note-grid{grid-template-columns:1fr}}
  .note-item .ni-lbl{font-size:11px;font-weight:600;color:var(--text-2);margin-bottom:2px}
  .note-item p{font-size:11.5px;color:var(--text-2);line-height:1.55}
  .note-item strong{color:var(--text);font-weight:600}
  .note-item code{font-family:var(--mono);font-size:10.5px;background:var(--surface2);
    border:1px solid var(--border);border-radius:3px;padding:1px 4px}
</style>

<!-- ── Header ── -->
<div class="page-header">
  <div>
    <h1>TPU Kernel Profiler — mega_kernel vs baseline</h1>
    <div class="meta">Qwen/Qwen3-4B · output-len=1 · batch=16 · two input lengths compared</div>
  </div>
  <div style="display:flex;gap:5px;flex-shrink:0;margin-top:2px">
    <span class="badge badge-mega">mega_kernel</span>
    <span class="badge badge-base">baseline</span>
  </div>
</div>

<!-- ── KPIs: forward pass totals ── -->
<div class="slabel">Main forward pass total (jit_run_model, 36 layers)</div>
<div class="kpi-grid">
  <div class="kpi">
    <div class="kpi-lbl">input=1000 · baseline</div>
    <div class="kpi-val good">39.87<span style="font-size:12px;font-weight:400;color:var(--text-2)">ms</span></div>
    <div class="kpi-sub">04:19 profile</div>
  </div>
  <div class="kpi">
    <div class="kpi-lbl">input=1000 · mega</div>
    <div class="kpi-val bad">67.83<span style="font-size:12px;font-weight:400;color:var(--text-2)">ms</span></div>
    <div class="kpi-sub" style="color:var(--mega)">1.70× slower</div>
  </div>
  <div class="kpi">
    <div class="kpi-lbl">input=4096 · baseline</div>
    <div class="kpi-val good">68.96<span style="font-size:12px;font-weight:400;color:var(--text-2)">ms</span></div>
    <div class="kpi-sub">05:04 profile</div>
  </div>
  <div class="kpi">
    <div class="kpi-lbl">input=4096 · mega</div>
    <div class="kpi-val bad">107.32<span style="font-size:12px;font-weight:400;color:var(--text-2)">ms</span></div>
    <div class="kpi-sub" style="color:var(--mega)">1.56× slower</div>
  </div>
</div>

<!-- ── Stacked bars ── -->
<div class="bar-section">
  <div class="slabel" style="margin-bottom:12px">Wall-time breakdown (same scale within each input-len pair)</div>

  <!-- input=1000 pair. Scale = mega total = 67.83ms = 100% -->
  <div style="font-size:10px;color:var(--text-3);margin-bottom:6px;letter-spacing:.05em">INPUT-LEN = 1 000 tokens/seq — kv_tiles ≈ 2/seq</div>
  <div class="bar-row">
    <div class="bar-run-label"><span class="run-dot" style="background:var(--base)"></span>baseline</div>
    <div class="bar-track">
      <!-- base1k total=39.87ms on 67.83 scale → 58.8%
           RPA:11.54→17.0%  QKV:6.39→9.4%  FFN:19.36→28.5%  copy:2.06→3.0%  misc:0.21→0.3%  rpad:0.25→0.4% -->
      <div class="bar-seg" style="width:17.0%;background:var(--c-rpa)" title="RPA prefill: 11.54ms"></div>
      <div class="bar-seg" style="width:9.4%;background:var(--c-qkv)"  title="XLA external QKV proj+QKNorm+RoPE: 6.39ms"></div>
      <div class="bar-seg" style="width:28.5%;background:var(--c-ffn)"  title="XLA fusions FFN+O_proj+element-wise: 19.36ms"></div>
      <div class="bar-seg" style="width:3.0%;background:var(--c-copy)"  title="copy: 2.06ms"></div>
      <div class="bar-seg" style="width:0.3%;background:var(--c-misc)"  title="misc: 0.21ms"></div>
      <div class="bar-seg" style="width:0.4%;background:var(--c-rpad)"  title="RPAd decode: 0.25ms"></div>
    </div>
    <div class="bar-ms good">39.87ms</div>
  </div>
  <div class="bar-row">
    <div class="bar-run-label"><span class="run-dot" style="background:var(--mega)"></span>mega</div>
    <div class="bar-track">
      <!-- mega1k: RPA:43.59→64.3%  FFN:19.36→28.5%  copy+bitcast:2.74→4.0%  misc:1.80→2.7%  rpad:0.25→0.4% -->
      <div class="bar-seg" style="width:64.3%;background:var(--c-rpa)"  title="RPA prefill (inc. fused QKV): 43.59ms"></div>
      <div class="bar-seg" style="width:28.5%;background:var(--c-ffn)"  title="XLA fusions FFN+O_proj: 19.36ms"></div>
      <div class="bar-seg" style="width:4.0%;background:var(--c-copy)"  title="copy+copy_bitcast: 2.74ms"></div>
      <div class="bar-seg" style="width:2.7%;background:var(--c-misc)"  title="pad_max+broadcast.clone: 1.80ms"></div>
      <div class="bar-seg" style="width:0.4%;background:var(--c-rpad)"  title="RPAd decode: 0.25ms"></div>
    </div>
    <div class="bar-ms bad">67.83ms</div>
  </div>

  <div style="height:10px"></div>

  <!-- input=4096 pair. Scale = mega total = 107.32ms = 100% -->
  <div style="font-size:10px;color:var(--text-3);margin-bottom:6px;letter-spacing:.05em">INPUT-LEN = 4 096 tokens/seq — kv_tiles ≈ 8/seq</div>
  <div class="bar-row">
    <div class="bar-run-label"><span class="run-dot" style="background:var(--base)"></span>baseline</div>
    <div class="bar-track">
      <!-- base4k total=68.96ms on 107.32 scale → 64.3%
           RPA:40.65→37.9%  QKV:6.39→6.0%  FFN:19.36→18.0%  copy:2.06→1.9%  misc:0.21→0.2%  rpad:0.25→0.2% -->
      <div class="bar-seg" style="width:37.9%;background:var(--c-rpa)"  title="RPA prefill: 40.65ms"></div>
      <div class="bar-seg" style="width:6.0%;background:var(--c-qkv)"   title="XLA external QKV proj+QKNorm+RoPE: 6.39ms"></div>
      <div class="bar-seg" style="width:18.0%;background:var(--c-ffn)"  title="XLA fusions FFN+O_proj: 19.36ms"></div>
      <div class="bar-seg" style="width:1.9%;background:var(--c-copy)"  title="copy: 2.06ms"></div>
      <div class="bar-seg" style="width:0.2%;background:var(--c-misc)"  title="misc: 0.21ms"></div>
      <div class="bar-seg" style="width:0.2%;background:var(--c-rpad)"  title="RPAd decode: 0.25ms"></div>
    </div>
    <div class="bar-ms good">68.96ms</div>
  </div>
  <div class="bar-row">
    <div class="bar-run-label"><span class="run-dot" style="background:var(--mega)"></span>mega</div>
    <div class="bar-track">
      <!-- mega4k: RPA:83.63→77.9%  FFN:18.83→17.5%  copy+bitcast:2.74→2.6%  misc:1.80→1.7%  rpad:0.25→0.2% -->
      <div class="bar-seg" style="width:77.9%;background:var(--c-rpa)"  title="RPA prefill (inc. fused QKV): 83.63ms"></div>
      <div class="bar-seg" style="width:17.5%;background:var(--c-ffn)"  title="XLA fusions FFN+O_proj: 18.83ms"></div>
      <div class="bar-seg" style="width:2.6%;background:var(--c-copy)"  title="copy+copy_bitcast: 2.74ms"></div>
      <div class="bar-seg" style="width:1.7%;background:var(--c-misc)"  title="pad_max+broadcast.clone: 1.80ms"></div>
      <div class="bar-seg" style="width:0.2%;background:var(--c-rpad)"  title="RPAd decode: 0.25ms"></div>
    </div>
    <div class="bar-ms bad">107.32ms</div>
  </div>

  <div class="bar-legend">
    <div class="leg-item"><span class="leg-dot" style="background:var(--c-rpa)"></span>RPA prefill kernel</div>
    <div class="leg-item"><span class="leg-dot" style="background:var(--c-qkv)"></span>XLA external QKV proj+QKNorm+RoPE (baseline only)</div>
    <div class="leg-item"><span class="leg-dot" style="background:var(--c-ffn)"></span>XLA fusions: FFN+O_proj+element-wise</div>
    <div class="leg-item"><span class="leg-dot" style="background:var(--c-copy)"></span>copy / bitcast</div>
    <div class="leg-item"><span class="leg-dot" style="background:var(--c-misc)"></span>pad / broadcast / misc</div>
    <div class="leg-item"><span class="leg-dot" style="background:var(--c-rpad)"></span>RPA decode</div>
  </div>
</div>

