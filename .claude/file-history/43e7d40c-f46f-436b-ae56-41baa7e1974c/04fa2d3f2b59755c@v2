import gzip, json, re
from collections import defaultdict

FALSE_TRACE = "/tmp/tpu_profiler_false/plugins/profile/2026_06_13_21_34_08/t1v-n-df792003-w-0.trace.json.gz"
TRUE_TRACE = "/tmp/tpu_profiler_true/plugins/profile/2026_06_13_21_38_06/t1v-n-df792003-w-0.trace.json.gz"

rms_pat = re.compile(r'= \(f32\[2048\]\{[^}]*\}, bf16\[2048,2560\]')
mlp_pat = re.compile(r'= bf16\[2048,9728\]')
fusion_name_re = re.compile(r'^fusion(\.\d+)?$')

def normalize(s):
    s = re.sub(r'\.\d+', '', s)
    s = re.sub(r'_\d+_', '_', s)
    return s

def find_pid(events):
    for e in events:
        if e.get('name','').startswith('jit_run_model('):
            return e['pid']
    return None

def load(path):
    with gzip.open(path) as f:
        data = json.load(f)
    events = data['traceEvents']
    pid = find_pid(events)
    fusions = [e for e in events if e.get('pid')==pid and fusion_name_re.match(e.get('name',''))]
    fusions.sort(key=lambda e: e['ts'])
    out = []
    for e in fusions:
        ln = e.get('args',{}).get('long_name','')
        ss = e.get('args',{}).get('source_stack','')
        if rms_pat.search(ln):
            kind = 'RMS'
        elif mlp_pat.search(ln):
            kind = 'MLP'
        else:
            continue
        qlines = [l.strip() for l in ss.splitlines() if 'qwen' in l.lower()]
        loc = qlines[0] if qlines else ''
        out.append((kind, loc, normalize(ln), e['dur'], e['ts']))
    return out

false_events = load(FALSE_TRACE)
true_events = load(TRUE_TRACE)

print(f"false: {len(false_events)} RMS/MLP fusion events")
print(f"true:  {len(true_events)} RMS/MLP fusion events")

# group by (kind, loc, normalized long_name) to match structurally identical instances
def group(events):
    g = defaultdict(list)
    for kind, loc, nln, dur, ts in events:
        g[(kind, loc, nln)].append((dur, ts))
    return g

