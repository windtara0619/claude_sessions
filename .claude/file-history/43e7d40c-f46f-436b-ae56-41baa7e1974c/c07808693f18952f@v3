function moveTip(e){
  const margin=12;
  let lx=e.clientX+margin, ly=e.clientY+margin;
  if(lx+tip.offsetWidth>window.innerWidth-4) lx=e.clientX-tip.offsetWidth-margin;
  if(ly+tip.offsetHeight>window.innerHeight-4) ly=e.clientY-tip.offsetHeight-margin;
  tip.style.left=lx+'px'; tip.style.top=ly+'px';
}
function hideTip(){tip.style.display='none';}

function wireHover(id){
  const cv=document.getElementById(id);if(!cv)return;
  cv.addEventListener('mousemove',e=>{
    const r=cv.getBoundingClientRect();
    const mx=e.clientX-r.left, my=e.clientY-r.top;
    const boxes=hitBoxes[id]||[];
    // search in reverse so topmost-drawn block wins
    for(let i=boxes.length-1;i>=0;i--){
      const b=boxes[i];
      if(mx>=b.x&&mx<=b.x+b.w&&my>=b.y&&my<=b.y+b.h){showTip(e,b);return;}
    }
    hideTip();
  });
  cv.addEventListener('mousemove',moveTip);
  cv.addEventListener('mouseleave',hideTip);
}

