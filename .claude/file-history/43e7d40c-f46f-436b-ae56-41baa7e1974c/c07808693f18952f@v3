    ctx.beginPath();
    ctx.moveTo(x0+r,y);ctx.lineTo(x0+bw-r,y);ctx.quadraticCurveTo(x0+bw,y,x0+bw,y+r);
    ctx.lineTo(x0+bw,y+bh-r);ctx.quadraticCurveTo(x0+bw,y+bh,x0+bw-r,y+bh);
    ctx.lineTo(x0+r,y+bh);ctx.quadraticCurveTo(x0,y+bh,x0,y+bh-r);
    ctx.lineTo(x0,y+r);ctx.quadraticCurveTo(x0,y,x0+r,y);
    ctx.closePath();ctx.fill();
    ctx.strokeStyle='rgba(0,0,0,0.25)';ctx.lineWidth=0.5;ctx.stroke();
    if(bw>28){
      ctx.fillStyle='rgba(0,0,0,0.8)';
      ctx.font=`${Math.min(8,bw/5)}px Consolas,monospace`;
      ctx.textAlign='center';ctx.textBaseline='middle';
      ctx.fillText((L[key]||key).substring(0,Math.floor(bw/5)),x0+bw/2,y+bh/2);
    }
    hitBoxes[id].push({x:x0,y,w:bw,h:bh,t0,t1,label:L[key]||lbl||key,track});
  });
}

function init(){
  draw('c0',DATA[0].ops,DATA[0].tot,DATA[0].scale,0);
  draw('c1',DATA[1].ops,DATA[1].tot,DATA[1].scale,0);
  draw('c2',DATA[2].ops,DATA[2].tot,DATA[2].scale,0);
  draw('z0',DATA[0].ops,DATA[0].tot,DATA[0].scale,80);
  draw('z1',DATA[1].ops,DATA[1].tot,DATA[1].scale,80);
  draw('z2',DATA[2].ops,DATA[2].tot,DATA[2].scale,200.0);
  ['c0','c1','c2','z0','z1','z2'].forEach(wireHover);
  const seen={},leg=document.getElementById('leg');
  DATA.forEach(d=>d.ops.forEach(([,,,,key])=>{
    if(seen[key])return;seen[key]=true;
    leg.innerHTML+=`<div class="li"><div class="lb" style="background:${C[key]||'#555'}"></div><span>${L[key]||key}</span></div>`;
  }));
}
window.addEventListener('load',init);
</script>
