<title>TPU Profile: mega_kernel vs baseline</title>
<style>
  /* ── Token system ── */
  :root {
    --bg:          #f5f7fa;
    --surface:     #ffffff;
    --surface2:    #f0f2f5;
    --border:      #dde1e7;
    --border-faint:#eaecf0;
    --text:        #1a1d23;
    --text-2:      #5c6370;
    --text-3:      #8b919e;

    --mega:        #e8570a;   /* orange — the slower run */
    --base:        #1a7f37;   /* green — the faster run  */
    --blue:        #0057cc;
    --purple:      #6e4cbe;
    --yellow:      #b07d00;
    --slate:       #5c6370;

    /* op-type strip colours */
    --c-rpa-pre:   #3b82f6;
    --c-fusion:    #8b5cf6;
    --c-copy:      #f59e0b;
    --c-rpa-dec:   #22c55e;
    --c-other:     #94a3b8;

    --mono: 'SF Mono', 'Fira Code', 'Cascadia Code', 'Consolas', monospace;
    --sans: 'Inter', 'SF Pro Text', system-ui, -apple-system, sans-serif;

    --r: 6px;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg:          #0d1117;
      --surface:     #161b22;
      --surface2:    #1c2128;
      --border:      #30363d;
      --border-faint:#21262d;
      --text:        #e6edf3;
      --text-2:      #8b949e;
      --text-3:      #58636e;

      --mega:        #f0883e;
      --base:        #3fb950;
      --blue:        #79c0ff;
      --purple:      #bc8cff;
      --yellow:      #e3b341;
      --slate:       #8b949e;

      --c-rpa-pre:   #4493f8;
      --c-fusion:    #a371f7;
      --c-copy:      #e3b341;
      --c-rpa-dec:   #3fb950;
      --c-other:     #58636e;
    }
  }
  :root[data-theme="light"] {
    --bg: #f5f7fa; --surface: #ffffff; --surface2: #f0f2f5;
    --border: #dde1e7; --border-faint: #eaecf0;
    --text: #1a1d23; --text-2: #5c6370; --text-3: #8b919e;
    --mega: #e8570a; --base: #1a7f37; --blue: #0057cc;
    --purple: #6e4cbe; --yellow: #b07d00; --slate: #5c6370;
    --c-rpa-pre: #3b82f6; --c-fusion: #8b5cf6; --c-copy: #f59e0b;
    --c-rpa-dec: #22c55e; --c-other: #94a3b8;
  }
  :root[data-theme="dark"] {
    --bg: #0d1117; --surface: #161b22; --surface2: #1c2128;
    --border: #30363d; --border-faint: #21262d;
    --text: #e6edf3; --text-2: #8b949e; --text-3: #58636e;
    --mega: #f0883e; --base: #3fb950; --blue: #79c0ff;
    --purple: #bc8cff; --yellow: #e3b341; --slate: #8b949e;
    --c-rpa-pre: #4493f8; --c-fusion: #a371f7; --c-copy: #e3b341;
    --c-rpa-dec: #3fb950; --c-other: #58636e;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--sans);
    font-size: 13px;
    line-height: 1.6;
    padding: 28px 24px 64px;
    max-width: 920px;
    margin: 0 auto;
  }

  /* ── Header ── */
  .page-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 28px;
  }
  .page-header h1 {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.3px;
    line-height: 1.3;
  }
  .page-header .meta {
    font-size: 12px;
    color: var(--text-2);
    margin-top: 4px;
    font-family: var(--mono);
  }
  .badge {
    display: inline-block;
    font-size: 11px;
    font-family: var(--mono);
    font-weight: 500;
    padding: 3px 8px;
    border-radius: 20px;
    white-space: nowrap;
  }
  .badge-mega { background: color-mix(in srgb, var(--mega) 14%, transparent); color: var(--mega); }
  .badge-base { background: color-mix(in srgb, var(--base) 14%, transparent); color: var(--base); }

  /* ── Section titles ── */
  .section-label {
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-3);
    margin-bottom: 10px;
  }

  /* ── Summary cards ── */
  .summary-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-bottom: 28px;
  }
  @media (max-width: 580px) { .summary-grid { grid-template-columns: 1fr 1fr; } }
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r);
    padding: 14px 16px;
  }
  .card-label {
    font-size: 11px;
    color: var(--text-2);
    margin-bottom: 6px;
    font-weight: 500;
  }
  .card-value {
    font-family: var(--mono);
    font-size: 22px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }
  .card-sub {
    font-size: 11px;
    color: var(--text-2);
    margin-top: 3px;
    font-family: var(--mono);
  }
  .val-bad  { color: var(--mega); }
  .val-good { color: var(--base); }
  .val-warn { color: var(--yellow); }

  /* ── Bar chart ── */
  .bar-section {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r);
    padding: 18px 20px 16px;
    margin-bottom: 20px;
  }
  .bar-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }
  .bar-row:last-of-type { margin-bottom: 0; }
  .bar-label {
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--text-2);
    width: 88px;
    flex-shrink: 0;
    text-align: right;
    white-space: nowrap;
  }
  .bar-label .run-dot {
    display: inline-block;
    width: 7px; height: 7px;
    border-radius: 50%;
    margin-right: 5px;
    vertical-align: middle;
    position: relative;
    top: -1px;
  }
  .bar-track {
    flex: 1;
    height: 28px;
    background: var(--surface2);
    border-radius: 3px;
    overflow: hidden;
    display: flex;
    position: relative;
  }
  .bar-seg {
    height: 100%;
    flex-shrink: 0;
    transition: opacity 0.15s;
    position: relative;
  }
  .bar-seg:hover { opacity: 0.85; }
  .bar-seg[title] { cursor: default; }
  .bar-total {
    font-family: var(--mono);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    color: var(--text);
    font-weight: 600;
    width: 64px;
    flex-shrink: 0;
    text-align: left;
  }

  /* Legend */
  .bar-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--border-faint);
  }
  .legend-item {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    color: var(--text-2);
  }
  .legend-dot {
    width: 9px; height: 9px;
    border-radius: 2px;
    flex-shrink: 0;
  }

  /* ── Comparison table ── */
  .table-wrap {
    overflow-x: auto;
    margin-bottom: 20px;
    border-radius: var(--r);
    border: 1px solid var(--border);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    background: var(--surface);
    font-size: 12.5px;
  }
  thead th {
    text-align: left;
    padding: 9px 14px;
    font-size: 10.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-3);
    border-bottom: 1px solid var(--border);
    background: var(--surface2);
    white-space: nowrap;
  }
  thead th.right { text-align: right; }
  tbody td {
    padding: 9px 14px;
    border-bottom: 1px solid var(--border-faint);
    vertical-align: middle;
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  tbody td.name-cell {
    font-family: var(--sans);
    font-size: 12px;
  }
  tbody td.right { text-align: right; }
  tbody tr:last-child td { border-bottom: none; }
  tbody tr:hover td { background: color-mix(in srgb, var(--text) 3%, transparent); }
  .ratio-chip {
    display: inline-block;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 20px;
  }
  .chip-bad  { background: color-mix(in srgb, var(--mega) 15%, transparent); color: var(--mega); }
  .chip-good { background: color-mix(in srgb, var(--base) 15%, transparent); color: var(--base); }
  .chip-neutral { background: var(--surface2); color: var(--text-2); }

  /* Inline mini-bar */
  .minibar-wrap { display: flex; align-items: center; gap: 6px; }
  .minibar {
    height: 4px; border-radius: 2px;
    display: inline-block;
    vertical-align: middle;
  }

  /* ── Analysis box ── */
  .analysis {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r);
    padding: 18px 20px;
    margin-bottom: 20px;
  }
  .analysis h3 {
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 12px;
  }
  .analysis-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  @media (max-width: 600px) { .analysis-grid { grid-template-columns: 1fr; } }
  .analysis-item {}
  .analysis-item .ai-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-2);
    margin-bottom: 4px;
  }
  .analysis-item p {
    font-size: 12px;
    color: var(--text-2);
    line-height: 1.55;
  }
  .analysis-item strong { color: var(--text); font-weight: 600; }
  .analysis-item code {
    font-family: var(--mono);
    font-size: 11px;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 1px 4px;
  }

  /* ── Run info row ── */
  .run-info {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 28px;
  }
  .run-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r);
    padding: 13px 16px;
    border-top: 3px solid;
  }
  .run-card.mega { border-top-color: var(--mega); }
  .run-card.base { border-top-color: var(--base); }
  .run-card .rc-title {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-2);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 4px;
  }
  .run-card .rc-id {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text);
    margin-bottom: 6px;
  }
  .run-card .rc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }
  .rc-tag {
    font-family: var(--mono);
    font-size: 10.5px;
    padding: 2px 6px;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 3px;
    color: var(--text-2);
  }
</style>

