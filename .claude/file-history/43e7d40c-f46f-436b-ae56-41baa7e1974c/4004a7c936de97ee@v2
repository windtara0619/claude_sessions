import glob
import gzip
import json
import os
import shutil
import sys
import time

import jax
import jax.numpy as jnp
import numpy as np

from tpu_inference.kernels.ragged_paged_attention.v3.kernel import (
    ragged_paged_attention)
from tpu_inference.kernels.ragged_paged_attention.v3.util import (align_to,
                                                                    cdiv,
                                                                    get_dtype_packing)

VARIANT = sys.argv[1] if len(sys.argv) > 1 else "baseline"
TRACE_DIR = f"/tmp/rope_kernel_trace_{VARIANT}"

rng = np.random.default_rng(1234)


def gen_random(shape, dtype):
    return jnp.array(rng.random(size=shape, dtype=np.float32)).astype(dtype)


# Shapes matching the "big prefill chunk" seen in the real traces:
# RPAm-p_128-bq_256_128-bkv_1024_512
seq_lens = [(256, 2048)]
num_heads = (32, 8)
head_dim = 128
page_size = 128
dtype = jnp.bfloat16
num_pages = 64
bq_sz, bkv_sz, bq_csz, bkv_csz = 256, 1024, 128, 512

cu_q_lens = [0]
kv_lens = []
for q_len, kv_len in seq_lens:
    cu_q_lens.append(cu_q_lens[-1] + q_len)
    kv_lens.append(kv_len)

max_num_batched_tokens = align_to(cu_q_lens[-1], 128)
max_num_seq = 8
max_kv_len = max(kv_lens)
pages_per_seq = cdiv(max_kv_len, page_size)
num_q_heads, num_kv_heads = num_heads

q = gen_random((max_num_batched_tokens, num_q_heads, head_dim), dtype)
k = gen_random((max_num_batched_tokens, num_kv_heads, head_dim), dtype)
v = gen_random((max_num_batched_tokens, num_kv_heads, head_dim), dtype)

kv_packing = get_dtype_packing(dtype)
padded_head_dim = align_to(head_dim, 128)
num_kv_heads_x2 = align_to(num_kv_heads * 2, kv_packing)

page_cnt = 0
page_indices_list = []
kv_pages_list = []
for kv_len in kv_lens:
    kv = gen_random(
        (kv_len, num_kv_heads_x2 // kv_packing, kv_packing, padded_head_dim),
        dtype,
    )
    kv = jnp.pad(
        kv,
        ((0, cdiv(kv_len, page_size) * page_size - kv_len), (0, 0), (0, 0),
         (0, 0)),
        constant_values=0,
    ).reshape(-1, page_size, num_kv_heads_x2 // kv_packing, kv_packing,
              padded_head_dim)
    indices = page_cnt + jnp.arange(kv.shape[0], dtype=jnp.int32)
    indices = jnp.pad(indices, ((0, pages_per_seq - indices.shape[0]), ),
                       constant_values=0)
    page_indices_list.append(indices)
    page_cnt += kv.shape[0]
    kv_pages_list.append(kv)

kv_cache = jnp.concatenate(kv_pages_list, axis=0)
kv_cache = jnp.pad(
    kv_cache,
    ((0, num_pages - kv_cache.shape[0]), (0, 0), (0, 0), (0, 0), (0, 0)),
    constant_values=0,
)
page_indices = jnp.stack(page_indices_list, axis=0)
page_indices = jnp.pad(page_indices,
                        ((0, max_num_seq - page_indices.shape[0]), (0, 0)),
                        constant_values=0)
page_indices = page_indices.reshape(-1)

cu_q_lens_arr = jnp.array(cu_q_lens, dtype=jnp.int32)
cu_q_lens_arr = jnp.pad(cu_q_lens_arr,
                         (0, max_num_seq + 1 - cu_q_lens_arr.shape[0]))
kv_lens_arr = jnp.array(kv_lens, dtype=jnp.int32)
kv_lens_arr = jnp.pad(kv_lens_arr, (0, max_num_seq - kv_lens_arr.shape[0]))
distribution = jnp.array([0, 0, len(seq_lens)], dtype=jnp.int32)

has_rope = os.environ.get("RPA_HAS_ROPE", "1") == "1"


@jax.jit
def run(q, k, v, kv_cache, kv_lens, page_indices, cu_q_lens, distribution):
    out, updated_kv_cache = ragged_paged_attention(
        q,
        k,
        v,
        kv_cache,
        kv_lens,
        page_indices,
        cu_q_lens,
        distribution,
        has_rope=has_rope,
        rope_theta=10000.0,
        m_block_sizes=(bq_sz, bkv_sz, bq_csz, bkv_csz),
        vmem_limit_bytes=100 * 1024 * 1024,
    )
    return out, updated_kv_cache


args = (q, k, v, kv_cache, kv_lens_arr, page_indices, cu_q_lens_arr,
        distribution)

# Warmup / compile
out, updated_kv_cache = run(*args)
jax.block_until_ready((out, updated_kv_cache))

if os.path.exists(TRACE_DIR):
    shutil.rmtree(TRACE_DIR)

N = 20
with jax.profiler.trace(TRACE_DIR):
    for _ in range(N):
        out, updated_kv_cache = run(*args)
    jax.block_until_ready((out, updated_kv_cache))

# Find the trace.json.gz
matches = glob.glob(os.path.join(TRACE_DIR, "**", "*.trace.json.gz"),
                     recursive=True)
assert matches, f"no trace found in {TRACE_DIR}"
trace_path = matches[0]
with gzip.open(trace_path, "rt") as f:
    data = json.load(f)

events = data["traceEvents"]
from collections import defaultdict
by_name = defaultdict(list)
for e in events:
    args_ = e.get("args", {})
    if not isinstance(args_, dict):
        continue
    if args_.get("hlo_category") == "custom-call" and (
            e.get("name", "").startswith("RPAm")
            or e.get("name", "").startswith("RPAd")):
        # strip trailing .NNN instance id
        base = e.get("name", "").rsplit(".", 1)[0]
        by_name[base].append((e.get("ts"), e.get("dur", 0)))

print(f"VARIANT={VARIANT} has_rope={has_rope}")
for base, vals in by_name.items():
    vals.sort()
    durs = np.array([d for _, d in vals])
    # drop first rep (compile/warmup tail effects)
    durs_trimmed = durs[1:] if len(durs) > 1 else durs
    print(f"{base}: n={len(durs)}")
    print(f"  all:     mean={durs.mean():.4f} median={np.median(durs):.4f} min={durs.min():.4f} max={durs.max():.4f}")
    print(f"  trimmed: mean={durs_trimmed.mean():.4f} median={np.median(durs_trimmed):.4f}")
