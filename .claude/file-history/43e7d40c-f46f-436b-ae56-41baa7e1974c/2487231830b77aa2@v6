<title>TPU Profile: mega_kernel vs baseline</title>
<style>
  :root {
    --bg:#f5f7fa;--surface:#fff;--surface2:#f0f2f5;
    --border:#dde1e7;--border-faint:#eaecf0;
    --text:#1a1d23;--text-2:#5c6370;--text-3:#8b919e;
    --mega:#e8570a;--base:#1a7f37;
    --c-rpa:#3b82f6;--c-ffn:#8b5cf6;--c-proj:#ef4444;
    --c-norm:#f59e0b;--c-misc:#94a3b8;--c-rpad:#22c55e;--c-stage:#f97316;
    --mono:'SF Mono','Fira Code','Cascadia Code','Consolas',monospace;
    --sans:'Inter','SF Pro Text',system-ui,-apple-system,sans-serif;
    --r:6px;
  }
  @media(prefers-color-scheme:dark){:root{
    --bg:#0d1117;--surface:#161b22;--surface2:#1c2128;
    --border:#30363d;--border-faint:#21262d;
    --text:#e6edf3;--text-2:#8b949e;--text-3:#58636e;
    --mega:#f0883e;--base:#3fb950;
    --c-rpa:#4493f8;--c-ffn:#a371f7;--c-proj:#f85149;
    --c-norm:#e3b341;--c-misc:#58636e;--c-rpad:#3fb950;--c-stage:#fb923c;
  }}
  :root[data-theme="light"]{
    --bg:#f5f7fa;--surface:#fff;--surface2:#f0f2f5;--border:#dde1e7;--border-faint:#eaecf0;
    --text:#1a1d23;--text-2:#5c6370;--text-3:#8b919e;--mega:#e8570a;--base:#1a7f37;
    --c-rpa:#3b82f6;--c-ffn:#8b5cf6;--c-proj:#ef4444;--c-norm:#f59e0b;--c-misc:#94a3b8;--c-rpad:#22c55e;--c-stage:#f97316;
  }
  :root[data-theme="dark"]{
    --bg:#0d1117;--surface:#161b22;--surface2:#1c2128;--border:#30363d;--border-faint:#21262d;
    --text:#e6edf3;--text-2:#8b949e;--text-3:#58636e;--mega:#f0883e;--base:#3fb950;
    --c-rpa:#4493f8;--c-ffn:#a371f7;--c-proj:#f85149;--c-norm:#e3b341;--c-misc:#58636e;--c-rpad:#3fb950;--c-stage:#fb923c;
  }
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
  body{background:var(--bg);color:var(--text);font-family:var(--sans);font-size:13px;
    line-height:1.6;padding:24px 20px 56px;max-width:980px;margin:0 auto}

  .ph{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;
    padding-bottom:15px;border-bottom:1px solid var(--border);margin-bottom:20px}
  .ph h1{font-size:17px;font-weight:600;letter-spacing:-.3px}
  .ph .meta{font-size:11px;color:var(--text-2);margin-top:3px;font-family:var(--mono)}
  .badge{display:inline-block;font-size:11px;font-family:var(--mono);font-weight:500;
    padding:3px 8px;border-radius:20px;white-space:nowrap}
  .bm{background:color-mix(in srgb,var(--mega) 14%,transparent);color:var(--mega)}
  .bb{background:color-mix(in srgb,var(--base) 14%,transparent);color:var(--base)}
  .sl{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;
    color:var(--text-3);margin-bottom:8px}

  /* table */
  .tw{overflow-x:auto;border-radius:var(--r);border:1px solid var(--border);margin-bottom:20px}
  table{width:100%;border-collapse:collapse;background:var(--surface);font-size:12px}
  th{text-align:left;padding:8px 12px;font-size:10px;font-weight:700;text-transform:uppercase;
    letter-spacing:.06em;color:var(--text-3);background:var(--surface2);
    border-bottom:1px solid var(--border);white-space:nowrap}
  th.r{text-align:right}
  td{padding:7px 12px;border-bottom:1px solid var(--border-faint);
    font-family:var(--mono);font-variant-numeric:tabular-nums;white-space:nowrap;vertical-align:middle}
  td.name{font-family:var(--sans);font-size:11.5px}
  td.r{text-align:right}
  tr:last-child td{border-bottom:none}
  tr:hover td{background:color-mix(in srgb,var(--text) 3%,transparent)}
  tr.sep td{border-top:2px solid var(--border);font-weight:700;
    background:color-mix(in srgb,var(--text) 4%,transparent)}
  tr.group-head td{background:color-mix(in srgb,var(--text) 2.5%,transparent);
    font-size:10px;text-transform:uppercase;letter-spacing:.06em;
    color:var(--text-3);border-top:1px solid var(--border);font-family:var(--sans)}
  tr.group-head td:first-child{font-weight:700}
  .chip{display:inline-block;font-family:var(--mono);font-size:10.5px;font-weight:600;
    padding:1px 6px;border-radius:20px}
  .cbad{background:color-mix(in srgb,var(--mega) 15%,transparent);color:var(--mega)}
  .cgood{background:color-mix(in srgb,var(--base) 15%,transparent);color:var(--base)}
  .cneu{background:var(--surface2);color:var(--text-2)}
  .sw{display:inline-block;width:7px;height:7px;border-radius:2px;
    margin-right:6px;vertical-align:middle;position:relative;top:-1px}
  .dim{color:var(--text-3)}
  .italic{font-style:italic;color:var(--text-3)}
  .bad{color:var(--mega)} .good{color:var(--base)}

  /* inline bar */
  .bar-inline{display:flex;align-items:center;gap:5px}
  .bar-fill{height:4px;border-radius:2px;flex-shrink:0}

  /* timeline visual */
  .timeline{display:flex;flex-direction:column;gap:6px;margin-bottom:20px}
  .tl-row{display:flex;align-items:center;gap:8px}
  .tl-label{font-family:var(--mono);font-size:10.5px;color:var(--text-2);
    width:90px;flex-shrink:0;text-align:right;white-space:nowrap}
  .tl-track{flex:1;height:24px;display:flex;background:var(--surface2);border-radius:3px;overflow:hidden}
  .tl-seg{height:100%;flex-shrink:0;cursor:default;position:relative}
  .tl-seg:hover{filter:brightness(1.1)}
  .tl-total{font-family:var(--mono);font-size:11px;font-weight:600;
    width:58px;flex-shrink:0;font-variant-numeric:tabular-nums}
  .tl-legend{display:flex;flex-wrap:wrap;gap:4px 12px;padding:10px 0 2px}
  .lg-item{display:flex;align-items:center;gap:4px;font-size:10.5px;color:var(--text-2)}
  .lg-dot{width:8px;height:8px;border-radius:2px;flex-shrink:0}

  /* cards */
  .card-row{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:20px}
  @media(max-width:600px){.card-row{grid-template-columns:1fr 1fr}}
  .card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:11px 13px}
  .cl{font-size:11px;color:var(--text-2);margin-bottom:4px}
  .cv{font-family:var(--mono);font-size:19px;font-weight:700;font-variant-numeric:tabular-nums;line-height:1.1}
  .cs{font-size:10.5px;color:var(--text-2);margin-top:2px;font-family:var(--mono)}
</style>

<div class="ph">
  <div>
    <h1>TPU Kernel Profiler — mega_kernel vs baseline</h1>
    <div class="meta">Qwen/Qwen3-4B · input=4096 · batch=16 · 2026-07-07 · averaged over 35 inter-layer windows</div>
  </div>
  <div style="display:flex;gap:5px;margin-top:2px">
    <span class="badge bm">mega_kernel</span>
    <span class="badge bb">baseline</span>
  </div>
</div>

<!-- KPIs -->
<div class="sl">Per-layer totals (averaged, input=4096)</div>
<div class="card-row">
  <div class="card"><div class="cl">baseline per layer</div>
    <div class="cv good">1.914<span style="font-size:12px;font-weight:400;color:var(--text-2)">ms</span></div>
    <div class="cs">0.785ms gap + 1.129ms RPA</div>
  </div>
  <div class="card"><div class="cl">mega per layer</div>
    <div class="cv bad">2.979<span style="font-size:12px;font-weight:400;color:var(--text-2)">ms</span></div>
    <div class="cs">0.655ms gap + 2.323ms RPA</div>
  </div>
  <div class="card"><div class="cl">gap saving (mega)</div>
    <div class="cv good">−0.130<span style="font-size:12px;font-weight:400;color:var(--text-2)">ms</span></div>
    <div class="cs">fewer XLA ops before RPA</div>
  </div>
  <div class="card"><div class="cl">RPA overhead (mega)</div>
    <div class="cv bad">+1.194<span style="font-size:12px;font-weight:400;color:var(--text-2)">ms</span></div>
    <div class="cs">tiled QKV proj inside kernel</div>
  </div>
</div>

<!-- Timeline visual -->
<div class="sl">Per-layer XLA pipeline (avg, one layer = gap + RPAm; scale = 2.979ms)</div>
<div style="background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:14px 16px 10px;margin-bottom:20px">
  <div class="timeline">
    <!-- baseline: total = 1.914ms on scale 2.979ms = 64.2%
         copy:0.013  norm:0.053  gate:0.135  up:0.134  down:0.177  misc:0.052  Q:0.133  KV:0.016  setup:0.049  rpad:0.007  RPAm:1.129 -->
    <div class="tl-row">
      <div class="tl-label"><span style="display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--base);margin-right:4px;vertical-align:middle"></span>baseline</div>
      <div class="tl-track">
        <div class="tl-seg" style="width:.44%;background:var(--c-misc)"   title="copy: 0.013ms"></div>
        <div class="tl-seg" style="width:1.78%;background:var(--c-norm)"  title="RMSNorm pre-FFN: 0.053ms"></div>
        <div class="tl-seg" style="width:4.53%;background:var(--c-ffn)"   title="FFN gate: 0.135ms"></div>
        <div class="tl-seg" style="width:4.50%;background:var(--c-ffn)"   title="FFN up: 0.134ms"></div>
        <div class="tl-seg" style="width:5.94%;background:var(--c-ffn)"   title="FFN down+residual: 0.177ms"></div>
        <div class="tl-seg" style="width:1.74%;background:var(--c-norm)"  title="norms+misc: 0.052ms"></div>
        <div class="tl-seg" style="width:.50%;background:var(--c-misc)"   title="copy: 0.015ms"></div>
        <div class="tl-seg" style="width:4.46%;background:var(--c-proj)"  title="Q projection: 0.133ms"></div>
        <div class="tl-seg" style="width:.54%;background:var(--c-proj)"   title="K projection: 0.008ms + QKNorm"></div>
        <div class="tl-seg" style="width:.54%;background:var(--c-proj)"   title="V projection: 0.008ms"></div>
        <div class="tl-seg" style="width:1.14%;background:var(--c-misc)"  title="pad+copy+setup: 0.034ms"></div>
        <div class="tl-seg" style="width:.24%;background:var(--c-rpad)"   title="RPAd: 0.007ms"></div>
        <!-- RPAm -->
        <div class="tl-seg" style="width:37.90%;background:var(--c-rpa)"  title="RPAm attention: 1.129ms"></div>
      </div>
      <div class="tl-total good">1.914ms</div>
    </div>
    <!-- mega: total = 2.979ms on scale 2.979ms = 100%
         copy:0.017  norm:0.053  gate:0.135  up:0.135  down:0.177  misc_small:0.008  copy2:0.020  broadcast:0.022  rpad:0.007  staging:0.036+0.026  RPAm:2.323 -->
    <div class="tl-row">
      <div class="tl-label"><span style="display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--mega);margin-right:4px;vertical-align:middle"></span>mega</div>
      <div class="tl-track">
        <div class="tl-seg" style="width:.57%;background:var(--c-misc)"   title="copy: 0.017ms"></div>
        <div class="tl-seg" style="width:1.78%;background:var(--c-norm)"  title="RMSNorm pre-FFN: 0.053ms"></div>
        <div class="tl-seg" style="width:4.53%;background:var(--c-ffn)"   title="FFN gate: 0.135ms"></div>
        <div class="tl-seg" style="width:4.53%;background:var(--c-ffn)"   title="FFN up: 0.135ms"></div>
        <div class="tl-seg" style="width:5.94%;background:var(--c-ffn)"   title="FFN down+residual: 0.177ms"></div>
        <div class="tl-seg" style="width:.27%;background:var(--c-norm)"   title="small norm: 0.008ms"></div>
        <div class="tl-seg" style="width:.67%;background:var(--c-misc)"   title="copy × 2: 0.020ms"></div>
        <div class="tl-seg" style="width:.74%;background:var(--c-stage)"  title="broadcast.1172.clone (W_qkv staging): 0.022ms"></div>
        <div class="tl-seg" style="width:.24%;background:var(--c-rpad)"   title="RPAd: 0.007ms"></div>
        <div class="tl-seg" style="width:1.21%;background:var(--c-stage)" title="copy_bitcast × 2 (x staging): 0.036ms"></div>
        <div class="tl-seg" style="width:.87%;background:var(--c-stage)"  title="pad_maximum (x padding): 0.026ms"></div>
        <!-- RPAm fused -->
        <div class="tl-seg" style="width:77.95%;background:var(--c-rpa)"  title="RPAm attention (incl. fused QKV proj): 2.323ms"></div>
      </div>
      <div class="tl-total bad">2.979ms</div>
    </div>
  </div>
  <div class="tl-legend">
    <div class="lg-item"><span class="lg-dot" style="background:var(--c-rpa)"></span>RPAm attention kernel</div>
    <div class="lg-item"><span class="lg-dot" style="background:var(--c-ffn)"></span>FFN (gate / up / down)</div>
    <div class="lg-item"><span class="lg-dot" style="background:var(--c-proj)"></span>Q / K / V projection (baseline only)</div>
    <div class="lg-item"><span class="lg-dot" style="background:var(--c-norm)"></span>RMSNorm</div>
    <div class="lg-item"><span class="lg-dot" style="background:var(--c-stage)"></span>W_qkv broadcast + x staging (mega only)</div>
    <div class="lg-item"><span class="lg-dot" style="background:var(--c-rpad)"></span>RPAd (decode)</div>
    <div class="lg-item"><span class="lg-dot" style="background:var(--c-misc)"></span>copy / routing</div>
  </div>
</div>

