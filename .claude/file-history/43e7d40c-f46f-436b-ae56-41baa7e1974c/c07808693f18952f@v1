const DMA_SUBS={'q_reads':0,'kv_reads':1,'kv_writes':2,'dma_read':0,'free':2};
const DS=16,DR=3,MH=30,VH=22,PAD_L=62,PAD_R=20,AH=20,MB=2;

function getW(scale){return Math.round(scale*US_PER_PX)+PAD_L+PAD_R;}

function draw(id,ops,tot,scale,zoom){
  const cv=document.getElementById(id);if(!cv)return;
  const END=zoom||scale;
  const W=zoom?Math.min(cv.parentElement.clientWidth-20,360):getW(scale);
  cv.width=W;cv.style.width=W+'px';
  const PW=W-PAD_L-PAD_R,H=cv.height;
  const ctx=cv.getContext('2d');
  const px=t=>PAD_L+Math.max(0,Math.min(1,t/END))*PW;

  ctx.fillStyle='#0d1117';ctx.fillRect(0,0,W,H);
  for(let s=0;s<DR;s++){ctx.fillStyle=s%2?'#111827':'#0d1117';ctx.fillRect(0,AH+s*DS,W,DS);}
  ctx.fillStyle='#0f172a';ctx.fillRect(0,AH+DR*DS,W,MH);
  ctx.fillStyle='#0d1117';ctx.fillRect(0,AH+DR*DS+MH,W,VH);

  [['q/dma',DS/2],['kv rds',DS*1.5],['writes',DS*2.5],['MXU',DR*DS+MH/2],['VPU',DR*DS+MH+VH/2]]
    .forEach(([l,dy])=>{
      ctx.fillStyle='#6e7681';ctx.font='bold 8px Consolas,monospace';
      ctx.textAlign='right';ctx.textBaseline='middle';
      ctx.fillText(l,PAD_L-4,AH+dy);
    });

  const ts=zoom?(END<=80?10:20):(scale<=300?50:100);
  for(let t=0;t<=END+1;t+=ts){
    const x=px(t);
    ctx.strokeStyle='#21262d';ctx.lineWidth=1;
    ctx.beginPath();ctx.moveTo(x,AH);ctx.lineTo(x,H);ctx.stroke();
    ctx.fillStyle='#6e7681';ctx.font='8px Consolas,monospace';
    ctx.textAlign='center';ctx.textBaseline='bottom';
    ctx.fillText(Math.round(t)+'µs',x,AH-2);
  }
  if(!zoom){
    const xE=px(tot);
    ctx.strokeStyle='#58a6ff';ctx.lineWidth=1.5;ctx.setLineDash([3,3]);
    ctx.beginPath();ctx.moveTo(xE,AH);ctx.lineTo(xE,H);ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle='#58a6ff';ctx.font='8px Consolas,monospace';
    ctx.textAlign='left';ctx.textBaseline='bottom';
    ctx.fillText(Math.round(tot)+'µs',xE+2,AH-2);
  }
  ctx.strokeStyle='#30363d';ctx.lineWidth=1;
  ctx.beginPath();ctx.moveTo(PAD_L,AH);ctx.lineTo(W-PAD_R,AH);ctx.stroke();

  ops.forEach(([t0,t1,track,sub,key])=>{
    if(t0>=END)return;
    const bw=Math.max(MB,px(Math.min(t1,END))-px(t0)),x0=px(t0);
    let y,bh;
    if(track==='DMA'){const si=DMA_SUBS[sub]??0;y=AH+si*DS+2;bh=DS-4;}
    else if(track==='MXU'){y=AH+DR*DS+2;bh=MH-4;}
    else{y=AH+DR*DS+MH+2;bh=VH-4;}
    const col=C[key]||'#555',r=Math.min(2,bw/2,bh/2);
    ctx.fillStyle=col;
    ctx.beginPath();
    ctx.moveTo(x0+r,y);ctx.lineTo(x0+bw-r,y);ctx.quadraticCurveTo(x0+bw,y,x0+bw,y+r);
    ctx.lineTo(x0+bw,y+bh-r);ctx.quadraticCurveTo(x0+bw,y+bh,x0+bw-r,y+bh);
    ctx.lineTo(x0+r,y+bh);ctx.quadraticCurveTo(x0,y+bh,x0,y+bh-r);
    ctx.lineTo(x0,y+r);ctx.quadraticCurveTo(x0,y,x0+r,y);
    ctx.closePath();ctx.fill();
    ctx.strokeStyle='rgba(0,0,0,0.25)';ctx.lineWidth=0.5;ctx.stroke();
    if(bw>28){
      ctx.fillStyle='rgba(0,0,0,0.8)';
      ctx.font=`${Math.min(8,bw/5)}px Consolas,monospace`;
      ctx.textAlign='center';ctx.textBaseline='middle';
      ctx.fillText((L[key]||key).substring(0,Math.floor(bw/5)),x0+bw/2,y+bh/2);
    }
  });
}

function init(){
  draw('c0',DATA[0].ops,DATA[0].tot,DATA[0].scale,0);
  draw('c1',DATA[1].ops,DATA[1].tot,DATA[1].scale,0);
  draw('c2',DATA[2].ops,DATA[2].tot,DATA[2].scale,0);
  draw('z0',DATA[0].ops,DATA[0].tot,DATA[0].scale,80);
  draw('z1',DATA[1].ops,DATA[1].tot,DATA[1].scale,80);
  draw('z2',DATA[2].ops,DATA[2].tot,DATA[2].scale,160.0);
  const seen={},leg=document.getElementById('leg');
  DATA.forEach(d=>d.ops.forEach(([,,,,key])=>{
    if(seen[key])return;seen[key]=true;
    leg.innerHTML+=`<div class="li"><div class="lb" style="background:${C[key]||'#555'}"></div><span>${L[key]||key}</span></div>`;
  }));
}
window.addEventListener('load',init);
</script>
